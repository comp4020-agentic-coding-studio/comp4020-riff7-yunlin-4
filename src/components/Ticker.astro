<script is:inline>
  // Countdowns between reloads: any element with data-until (a UTC instant)
  // and data-seg-ms gets --frac set to the share of its segment still left,
  // and its [data-left] child the time remaining. [data-clock] shows
  // Canberra wall time.
  (() => {
    const clock = new Intl.DateTimeFormat("en-AU", {
      timeZone: "Australia/Canberra",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    const left = (ms) => {
      const s = Math.max(0, Math.round(ms / 1000));
      if (s < 3600) return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
      const m = Math.floor(s / 60);
      return `${Math.floor(m / 60)}h ${String(m % 60).padStart(2, "0")}m`;
    };
    const tick = () => {
      const now = Date.now();
      for (const el of document.querySelectorAll("[data-until]")) {
        const remaining = Number(el.dataset.until) - now;
        el.style.setProperty("--frac", String(Math.max(0, Math.min(1, remaining / Number(el.dataset.segMs)))));
        for (const label of el.querySelectorAll("[data-left]")) label.textContent = left(remaining);
      }
      for (const el of document.querySelectorAll("[data-clock]")) el.textContent = clock.format(new Date(now));
    };
    tick();
    setInterval(tick, 1000);
  })();
</script>
