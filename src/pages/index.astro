---
import { canberraParts, canberraWallTimeToEpochMs, nextReloadTargetEpochMs, shiftDate } from "../lib/clock";
import { listBookingsForDate, listRooms } from "../lib/db";
import {
  CHECK_IN_GRACE_MIN,
  type Day,
  reloadBoundaries,
  remainingFraction,
  roomStatus,
  slotState,
  splitRoomName,
} from "../lib/status";
import Layout from "../components/Layout.astro";
import LiveReload from "../components/LiveReload.astro";
import Ticker from "../components/Ticker.astro";

// All times on this board are Canberra wall-clock text (see src/lib/schema.ts)
// — "now" has to be read the same way, regardless of what timezone the
// machine running the server happens to be in.
const { date: today, time: nowTime } = canberraParts(new Date());
const requestedDate = Astro.url.searchParams.get("date");
const date = requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) ? requestedDate : today;
const isToday = date === today;
const error = Astro.url.searchParams.get("error");

const errorMessages: Record<string, string> = {
  conflict: "That room is already booked for part of this time — pick another slot.",
  date: "That's not a date the board understands — pick one from the calendar.",
  invalid: "The end time has to be after the start time.",
  name: "Enter your name so the room knows who's got it.",
  room: "Pick a room.",
};

const rooms = listRooms();
const bookingsForDate = listBookingsForDate(date);
// Each booking's state (upcoming / awaiting check-in / live / no-show / past)
// is decided here in plain TS and carried on the data — the Astro compiler
// reads a bare `<` inside a template expression as the start of a tag.
const day: Day = date < today ? "past" : isToday ? "today" : "future";
const stateLabel = { past: "", upcoming: "", live: "In use", awaiting: "Check-in due", noshow: "No-show" };
const roomsWithBookings = rooms.map((room) => {
  const own = bookingsForDate.filter((b) => b.roomId === room.id);
  return {
    room,
    status: isToday ? roomStatus(own, nowTime) : null,
    bookings: own.map((b) => ({ ...b, state: slotState(b, day, nowTime) })),
  };
});

// Passed to the client script below so a tab left open across a booking's
// start/end minute — or across midnight, with no bookings left to wait for
// today — reloads itself right then, instead of only when some other tab's
// booking happens to trigger the SSE reload. A tab parked on *tomorrow*'s
// view gets the same treatment for the one boundary that matters to it: the
// moment real midnight arrives, this date stops being tomorrow and becomes
// today, so its "(today)" label and live highlighting need to switch on —
// any date further out has no near-term boundary worth waiting for.
//
// This is the real UTC instant of that boundary, not a minute count: a
// minute count handed to the client's own setTimeout would assume a
// wall-clock minute is always a real minute, which is false on the two
// nights a year Canberra's clocks shift for daylight saving (see
// canberraWallTimeToEpochMs in src/lib/clock.ts) — the client instead
// computes its own delay as target-minus-now at load time.
const nextBoundaryTarget = isToday
  ? nextReloadTargetEpochMs(date, nowTime, reloadBoundaries(bookingsForDate))
  : date === shiftDate(today, 1)
    ? canberraWallTimeToEpochMs(date, "00:00")
    : null;

// --- The timeline grid ---------------------------------------------------
// Rooms are rows against one shared hour axis, like a real room-booking
// calendar, so the free gaps read at a glance instead of having to be
// inferred from a list of times. The axis covers 08:00–20:00 by default and
// stretches to fit any booking outside that.
const toMin = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};
let startHour = 8;
let endHour = 20;
for (const b of bookingsForDate) {
  startHour = Math.min(startHour, Math.floor(toMin(b.startTime) / 60));
  endHour = Math.max(endHour, Math.ceil(toMin(b.endTime) / 60));
}
const axisStart = startHour * 60;
const axisSpan = (endHour - startHour) * 60;
const hours = Array.from({ length: endHour - startHour }, (_, i) => startHour + i);
const pct = (hhmm: string) => ((toMin(hhmm) - axisStart) / axisSpan) * 100;
const nowMin = toMin(nowTime);
const nowFraction = isToday && nowMin >= axisStart && nowMin <= axisStart + axisSpan ? (nowMin - axisStart) / axisSpan : null;

// "Hancock — Group Room 1" → library "Hancock", row label "Group Room 1".
type Row = (typeof roomsWithBookings)[number] & { label: string };
const libraries: { name: string; rows: Row[] }[] = [];
for (const entry of roomsWithBookings) {
  const [library, label] = splitRoomName(entry.room.name);
  let group = libraries.find((l) => l.name === library);
  if (!group) libraries.push((group = { name: library, rows: [] }));
  group.rows.push({ ...entry, label });
}

// The door tiles: one per room, the same state its door sign shows.
const doors = roomsWithBookings.flatMap(({ room, status }) => {
  if (!status) return [];
  const [library, label] = splitRoomName(room.name);
  const until = status.until ? canberraWallTimeToEpochMs(date, status.until) : null;
  const detail =
    status.kind === "busy"
      ? `${status.booking?.bookedBy} · until ${status.until}`
      : status.kind === "awaiting"
        ? `${status.booking?.bookedBy} hasn't checked in`
        : status.released
          ? `${status.released.bookedBy} was a no-show`
          : status.next
            ? `until ${status.next.startTime}`
            : "for the rest of today";
  return [{ room, library, label, status, until, detail, frac: remainingFraction(status, nowTime) }];
});
const freeNow = doors.filter((d) => d.status.kind === "free").length;

const fmtDate = (d: string, opts: Intl.DateTimeFormatOptions) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString("en-AU", { timeZone: "UTC", ...opts });
const prevDate = shiftDate(date, -1);
const nextDate = shiftDate(date, 1);
---

<Layout
  title="Room board"
  current="board"
  description="A live board for ANU Library group study rooms — book a slot, see who's got a room right now, cancel one you don't need."
>
  <main>
  <div class="pagehead">
    <div class="pagehead-inner">
      <div class="pagehead-top">
        <div>
          <p class="eyebrow">ANU Library · Group study rooms</p>
          <h1>Room board</h1>
        </div>
        {isToday ? (
          <p class="headline-stat">
            <strong>{freeNow}</strong>
            <span>of {rooms.length} rooms<br />free right now</span>
          </p>
        ) : (
          <p class="headline-stat">
            <strong>{bookingsForDate.length}</strong>
            <span>{bookingsForDate.length === 1 ? "booking" : "bookings"}<br />on this day</span>
          </p>
        )}
      </div>

      {isToday && (
        <ul class="doors" aria-label="Rooms right now">
          {doors.map((d) => (
            <li>
              <a
                class={`door door-${d.status.kind}`}
                href={`/room/${d.room.id}/`}
                data-until={d.until ?? undefined}
                data-seg-ms={d.status.segMin * 60_000}
                style={`--frac: ${d.frac}`}
              >
                <span class="door-lib">{d.library}</span>
                <span class="door-room">{d.label}</span>
                <span class="door-word">{{ free: "Free", busy: "In use", awaiting: "Check-in due" }[d.status.kind]}</span>
                <span class="door-detail">
                  {d.detail}
                  {d.until && d.status.kind === "busy" && (
                    <span class="door-left">
                      {" "}· <span data-left></span> left
                    </span>
                  )}
                  {d.until && d.status.kind === "awaiting" && (
                    <span class="door-left">
                      {" "}· <span data-left></span> to check in
                    </span>
                  )}
                  {d.until && d.status.kind === "free" && d.status.released && (
                    <span class="door-left">
                      {" "}· free for <span data-left></span>
                    </span>
                  )}
                </span>
                <span class="door-bar" aria-hidden="true"><span></span></span>
                <span class="door-open">Open door sign &rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="page">
    {error && (
      <p class="error" role="alert">
        {errorMessages[error] ?? "Something went wrong — try again."}
      </p>
    )}

    <section class="card" aria-labelledby="rooms-heading">
      <div class="card-head">
        <h2 id="rooms-heading">Available rooms</h2>
        <nav aria-label="date" class="datenav">
          <a class="step" href={`/?date=${prevDate}`} aria-label={`Previous day, ${prevDate}`}>&lsaquo;</a>
          <strong>
            {fmtDate(date, { weekday: "long", day: "numeric", month: "long", year: "numeric" })}
            {isToday && <span class="today-tag">Today</span>}
          </strong>
          <a class="step" href={`/?date=${nextDate}`} aria-label={`Next day, ${nextDate}`}>&rsaquo;</a>
          {!isToday && <a class="jump" href="/">Back to today</a>}
        </nav>
      </div>

      <div class="chips" role="group" aria-label="Filter by library">
        <button type="button" class="chip" aria-pressed="true" data-library="">All libraries</button>
        {libraries.map((l) => (
          <button type="button" class="chip" aria-pressed="false" data-library={l.name}>{l.name} Library</button>
        ))}
      </div>

      <div class="timeline-scroll">
        <div class="timeline" style={`--cols: ${hours.length}`} data-axis-start={axisStart} data-axis-span={axisSpan}>
          <div class="tl-row tl-scale" aria-hidden="true">
            <span class="tl-label">Room</span>
            <div class="tl-track">
              {hours.map((h, i) => (
                <span class="tl-hour" style={`left: ${(i / hours.length) * 100}%`}>{String(h).padStart(2, "0")}:00</span>
              ))}
            </div>
          </div>

          {libraries.map((library) => (
            <div class="tl-group" data-library={library.name}>
              <h3 class="tl-group-title">{library.name} Library</h3>
              {library.rows.map(({ label, room, bookings, status }) => (
                <div class={`tl-row${status && status.kind !== "free" ? " is-live" : ""}`}>
                  <span class="tl-label">
                    {status && <i class={`dot dot-${status.kind}`} aria-hidden="true"></i>}
                    <a href={`/room/${room.id}/`}>{label}</a>
                  </span>
                  <div class="tl-track" data-room-id={room.id}>
                    {bookings.length === 0 && <span class="tl-empty">Free all day</span>}
                    {bookings.map((booking) => (
                      <div
                        class={`slot is-${booking.state}`}
                        style={`left: ${pct(booking.startTime)}%; width: ${pct(booking.endTime) - pct(booking.startTime)}%`}
                      >
                        <span class="time">
                          {booking.startTime}–{booking.endTime}
                        </span>
                        <span class="who">{booking.bookedBy}</span>
                        {stateLabel[booking.state] && <span class="tag">{stateLabel[booking.state]}</span>}
                        <form method="post" action={`/api/bookings/${booking.id}/cancel`}>
                          <input type="hidden" name="date" value={date} />
                          <button type="submit" aria-label={`Cancel booking for ${booking.bookedBy}`}>&times;</button>
                        </form>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ))}

          {nowFraction !== null && (
            <div class="now-line" style={`--at: ${nowFraction}`} aria-hidden="true">
              <span class="now-pill">{nowTime}</span>
            </div>
          )}
        </div>
      </div>

      <p class="legend">
        <span><i class="swatch swatch-booked"></i>Booked</span>
        <span><i class="swatch swatch-now"></i>In use (checked in)</span>
        <span><i class="swatch swatch-wait"></i>Check-in due</span>
        <span><i class="swatch swatch-noshow"></i>No-show, released</span>
        <span><i class="swatch swatch-free"></i>Free — click to book</span>
      </p>
    </section>

    <div class="split">
      <form method="post" action="/api/bookings" class="card book-form" id="book">
        <div class="card-head">
          <h2>Book a room</h2>
        </div>
        <div class="book-grid">
          <input type="hidden" name="date" value={date} />
          <div class="field field-wide">
            <label for="roomId">Room</label>
            <select id="roomId" name="roomId" required>
              {rooms.map((room) => (
                <option value={room.id}>{room.name}</option>
              ))}
            </select>
          </div>
          <div class="field field-wide">
            <label for="bookedBy">Your name</label>
            <input id="bookedBy" name="bookedBy" required maxlength="80" autocomplete="name" />
          </div>
          <div class="field">
            <label for="startTime">From</label>
            <input id="startTime" name="startTime" type="time" required />
          </div>
          <div class="field">
            <label for="endTime">To</label>
            <input id="endTime" name="endTime" type="time" required />
          </div>
          <button class="primary">Book {fmtDate(date, { weekday: "short", day: "numeric", month: "short" })}</button>
        </div>
      </form>

      <aside class="card summary" aria-labelledby="summary-heading">
        <div class="card-head">
          <h2 id="summary-heading">No more phantom bookings</h2>
        </div>
        <ol class="howto">
          <li>
            <i class="dot dot-awaiting" aria-hidden="true"></i>
            <span>When a booking starts, the room's door sign asks whoever booked it to <strong>check in</strong>.</span>
          </li>
          <li>
            <i class="dot dot-busy" aria-hidden="true"></i>
            <span>Checked in, the room reads <strong>in use</strong> on the board and at the door.</span>
          </li>
          <li>
            <i class="dot dot-free" aria-hidden="true"></i>
            <span>
              Nobody by {CHECK_IN_GRACE_MIN} minutes in? It's a <strong>no-show</strong>: the room goes back to free and anyone
              at the door can take it.
            </span>
          </li>
        </ol>
        <p class="muted small howto-foot">Everything here updates live when anyone books, checks in or leaves.</p>
      </aside>
    </div>
  </div>
  </main>

  <LiveReload date={date} nextBoundaryTarget={nextBoundaryTarget} />
  <Ticker />

  <script is:inline>
    // The calendar half: hover an empty stretch of a room's row to preview a
    // one-hour slot, click it and the booking form fills itself in. The form
    // stays the source of truth; this only saves typing.
    (() => {
      const timeline = document.querySelector(".timeline");
      if (!timeline) return;
      const axisStart = Number(timeline.dataset.axisStart);
      const axisSpan = Number(timeline.dataset.axisSpan);
      const pad = (n) => String(n).padStart(2, "0");
      const hhmm = (m) => `${pad(Math.floor(m / 60))}:${pad(m % 60)}`;
      const slotAt = (track, clientX) => {
        const rect = track.getBoundingClientRect();
        const frac = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        const start = Math.min(axisStart + Math.floor((frac * axisSpan) / 30) * 30, axisStart + axisSpan - 60);
        return { start, end: start + 60 };
      };
      const place = (el, { start, end }) => {
        el.style.left = `${((start - axisStart) / axisSpan) * 100}%`;
        el.style.width = `${((end - start) / axisSpan) * 100}%`;
        el.textContent = `${hhmm(start)} – ${hhmm(end)}`;
      };
      for (const track of timeline.querySelectorAll(".tl-track[data-room-id]")) {
        track.addEventListener("mousemove", (e) => {
          let ghost = track.querySelector(".ghost");
          if (e.target.closest(".slot")) return ghost?.remove();
          if (!ghost) {
            ghost = document.createElement("div");
            ghost.className = "ghost";
            track.appendChild(ghost);
          }
          place(ghost, slotAt(track, e.clientX));
        });
        track.addEventListener("mouseleave", () => track.querySelector(".ghost")?.remove());
        track.addEventListener("click", (e) => {
          if (e.target.closest(".slot")) return;
          const slot = slotAt(track, e.clientX);
          timeline.querySelectorAll(".picked").forEach((p) => p.remove());
          const picked = document.createElement("div");
          picked.className = "picked";
          place(picked, slot);
          track.appendChild(picked);
          document.getElementById("roomId").value = track.dataset.roomId;
          document.getElementById("startTime").value = hhmm(slot.start);
          document.getElementById("endTime").value = hhmm(slot.end);
          document.getElementById("book").scrollIntoView({ behavior: "smooth", block: "center" });
          document.getElementById("bookedBy").focus({ preventScroll: true });
        });
      }

      // Library filter chips.
      const chips = document.querySelectorAll(".chip");
      for (const chip of chips) {
        chip.addEventListener("click", () => {
          chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
          for (const group of timeline.querySelectorAll(".tl-group")) {
            group.hidden = chip.dataset.library !== "" && group.dataset.library !== chip.dataset.library;
          }
        });
      }

      // Keep the now-line creeping forward between the page's boundary
      // reloads, read from the same Canberra wall clock the server uses.
      const line = timeline.querySelector(".now-line");
      if (line) {
        const fmt = new Intl.DateTimeFormat("en-AU", {
          timeZone: "Australia/Canberra",
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        });
        setInterval(() => {
          const [h, m] = fmt.format(new Date()).split(":").map(Number);
          const mins = (h % 24) * 60 + m;
          const frac = (mins - axisStart) / axisSpan;
          if (frac < 0 || frac > 1) return;
          line.style.setProperty("--at", String(frac));
          line.querySelector(".now-pill").textContent = hhmm(mins);
        }, 20_000);
      }
    })();
  </script>
</Layout>
